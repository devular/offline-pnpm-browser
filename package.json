{
  "name": "offline-pnpm-browser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite build && node start.js",
    "discover": "node scripts/discover.js",
    "fetch": "node scripts/fetch-all.js",
    "verify": "node scripts/verify.js",
    "pipeline": "node scripts/discover.js && node scripts/fetch-all.js && node scripts/verify.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "restore:list": "node scripts/restore.js --list",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.168.2",
    "@zip.js/zip.js": "^2.8.26",
    "marked": "^17.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sugar-high": "^1.0.0",
    "undici": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --write",
      "oxlint -c oxlintrc.json",
      "bash -c 'tsc --noEmit'"
    ],
    "*.{js,jsx}": [
      "oxfmt --write",
      "oxlint -c oxlintrc.json"
    ],
    "*.{css,html,json}": [
      "oxfmt --write"
    ]
  }
}

{
  "name": "offline-setup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx tsx scripts/serve.ts",
    "index": "npx tsx scripts/index-store.ts",
    "discover": "node scripts/discover.js",
    "fetch": "node scripts/fetch-all.js",
    "verify": "node scripts/verify.js",
    "pipeline": "node scripts/discover.js && node scripts/fetch-all.js && node scripts/verify.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "restore:list": "node scripts/restore.js --list",
    "prepare": "husky"
  },
  "dependencies": {
    "fastify": "^5.8.2",
    "fuse.js": "^7.0.0",
    "undici": "^6.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --write",
      "oxlint -c oxlintrc.json"
    ],
    "*.{js,jsx}": [
      "oxfmt --write",
      "oxlint -c oxlintrc.json"
    ],
    "*.{css,html,json}": [
      "oxfmt --write"
    ]
  }
}
